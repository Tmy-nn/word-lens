/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
/
  Cache-Control: no-cache
/detector-worker.js
  Cache-Control: no-cache
/detector/*
  Cache-Control: public, max-age=604800
/expanded-worker.js
  Cache-Control: no-cache
/expanded/*
  Cache-Control: public, max-age=604800
